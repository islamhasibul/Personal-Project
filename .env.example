# DevDesk environment variables
#
# Copy this file to `.env.local` and fill in the real values from your
# Supabase project (Project Settings -> API).
#
# `.env.local` is gitignored. This file contains placeholders only and
# IS committed on purpose.
#
# NOTE: Only the anon / publishable key belongs here. The service-role
# key must never be placed in this project — it bypasses Row Level
# Security and is not used by the application.

# Your Supabase project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The anon / publishable key. Safe to expose to the browser:
# Row Level Security is what protects your data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
